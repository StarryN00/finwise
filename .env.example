FINWISE_DATABASE_PATH=./data/finwise.db
FINWISE_STORAGE_PATH=./data/artifacts
FINWISE_REQUIRE_AUTH=true
FINWISE_ENVIRONMENT=development

# Real Agent Gateway is disabled by default for local fixture tests.
FINWISE_AGENT_MODE=disabled
FINWISE_AGENT_PROVIDER=deepseek
FINWISE_AGENT_MODEL=deepseek-chat
# 按任务分级。留空则沿用 FINWISE_AGENT_MODEL。
# 推理档：结构方案、问题复核、工资表结构识别 —— 一个模板只跑几次，选准不选便宜。
FINWISE_AGENT_MODEL_REASONING=deepseek-v4-pro
# 视觉档：扫描件与图片型 PDF 对账单。deepseek-v4-pro 不支持图像理解，这里只能填 flash。
FINWISE_AGENT_MODEL_VISION=deepseek-flash
# 快档：高频低难度的轻任务。
FINWISE_AGENT_MODEL_FAST=deepseek-flash
FINWISE_DEEPSEEK_BASE_URL=https://api.deepseek.com
FINWISE_DEEPSEEK_API_KEY=
FINWISE_AGENT_PROMPT_VERSION=finwise-agent-prompt-v1
FINWISE_AGENT_MAX_TOKENS=4000
# 把整条记录（摘要、往来单位、金额、账号）原样发给模型服务商，而不是只发字段名与枚举。
# 脱敏包里模型看不到任何业务内容，只能答"缺字段，去要材料"。
# 这是把客户财务数据交给外部服务商，默认关闭，由部署方明确打开。
FINWISE_AGENT_SEND_FULL_RECORDS=false
# 推理档先花额度在推理上，答案还没开始写就可能到顶；1200 下 PROBLEM_REVIEW 必然被截断。
FINWISE_AGENT_REASONING_MAX_TOKENS=8000
FINWISE_GATEWAY_TIMEOUT_SECONDS=45
# 推理档要先想再写，45 秒常常不够；超时的表现和模型答不上来一样。
FINWISE_GATEWAY_REASONING_TIMEOUT_SECONDS=180
FINWISE_GATEWAY_MAX_RETRIES=0
FINWISE_AGENT_LOOP_ENABLED=true
FINWISE_AGENT_LOOP_MAX_STEPS=12

# Scope-owned autonomous stage 2/3 processing (manual voucher review remains required).
FINWISE_AUTONOMOUS_ENABLED=false
FINWISE_AUTONOMOUS_CODEX_PATH=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
FINWISE_AUTONOMOUS_MODEL=gpt-6-astra
FINWISE_AUTONOMOUS_MAX_ROUNDS=3
FINWISE_AUTONOMOUS_TIMEOUT=1500
# The current workflow supports Codex CLI and Claude Code, selected per scope.
FINWISE_AUTONOMOUS_BACKEND=codex
FINWISE_AUTONOMOUS_CLAUDE_PATH=claude
FINWISE_AUTONOMOUS_CLAUDE_MODEL=deepseek-flash[1m]
# DeepSeek endpoint reuses FINWISE_DEEPSEEK_API_KEY when this override is empty.
FINWISE_CLAUDE_API_KEY=
FINWISE_CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
# 0 disables the CLI cost ceiling; usage is still recorded.
FINWISE_CLAUDE_BUDGET_USD=0
FINWISE_CODEX_API_KEY=
# Local desktop login is development-only. Servers use isolated task containers.
FINWISE_AUTONOMOUS_EXECUTION_MODE=local
FINWISE_AUTONOMOUS_CONTAINER_IMAGE=finwise-agent:20260925
FINWISE_AUTONOMOUS_HOST_RUN_ROOT=
FINWISE_AUTONOMOUS_DOCKER_PATH=docker
