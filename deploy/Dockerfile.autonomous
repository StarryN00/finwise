FROM node:22-bookworm-slim AS agent
ARG CLAUDE_CODE_VERSION=2.1.123
ARG CODEX_VERSION=0.156.1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir 'openpyxl>=3.1,<4' 'xlrd>=2,<3' 'pypdf>=5,<7' 'pillow>=10,<12' rapidocr==3.9.2 'onnxruntime>=1.20,<2' \
    && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} @openai/codex@${CODEX_VERSION}
RUN /opt/venv/bin/pip uninstall -y opencv-python \
    && /opt/venv/bin/pip install --no-cache-dir opencv-python-headless==4.11.0.86
COPY deploy/warm_ocr.py /tmp/warm_ocr.py
RUN /opt/venv/bin/python /tmp/warm_ocr.py && rm /tmp/warm_ocr.py
WORKDIR /workspace

FROM docker:27-cli AS docker_cli
FROM python:3.12-slim AS server
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/finwise
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY pyproject.toml README.md ./
RUN python -c "import tomllib, subprocess; p=tomllib.load(open('pyproject.toml','rb'))['project']; subprocess.check_call(['pip','install','--no-cache-dir',*p['dependencies'],*p['optional-dependencies']['pdf-ocr']])" \
    && useradd --create-home --uid 10001 finwise \
    && mkdir -p /var/lib/finwise/artifacts \
    && chown -R finwise:finwise /var/lib/finwise
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip uninstall -y opencv-python \
    && pip install --no-cache-dir opencv-python-headless==4.11.0.86
COPY deploy/warm_ocr.py /tmp/warm_ocr.py
RUN python /tmp/warm_ocr.py && rm /tmp/warm_ocr.py
COPY app ./app
COPY migrations ./migrations
COPY static ./static
COPY scripts ./scripts
RUN pip install --no-cache-dir --no-deps .
USER finwise
EXPOSE 8766
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/api/v1/health', timeout=3).read()"
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8766"]
